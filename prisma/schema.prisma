generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  passwordHash      String
  preferredLocale   String    @default("en")
  emailVerified     DateTime?
  verificationToken String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  products          Product[]
  aiConnections     AIConnection[]
  subscription      Subscription?
  usageEvents       UsageEvent[]
}

model Subscription {
  id               String          @id @default(cuid())
  userId           String          @unique
  plan             PlanTier        @default(FREE)
  interval         BillingInterval @default(MONTHLY)
  status           SubStatus       @default(ACTIVE)
  stripeSubId      String?
  stripeCustomerId String?
  currentPeriodEnd DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UsageEvent {
  id        String        @id @default(cuid())
  userId    String
  resource  UsageResource
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, resource, createdAt])
}

model Waitlist {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String?
  source            String         @default("landing")
  status            WaitlistStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  inviteCode        String?        @unique
  inviteCodeUsedAt  DateTime?
  emailVerifiedAt   DateTime?
  verificationToken String?        @unique

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Product {
  id                String             @id @default(cuid())
  userId            String
  name              String
  status            ProductStatus      @default(PRE_LAUNCH)
  launchDate        DateTime?
  description       String?
  category          String?
  targetAudience    String?
  businessModel     String?
  website           String?
  launchStatus      String?
  logoUrl           String?
  launchGoals       String?
  planMeta          String?
  additionalContext String?
  uploadedFiles     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  activationFunnels ActivationFunnel[]
  goals             Goal[]
  growthChecklists  GrowthChecklist[]
  routines          GrowthRoutine[]
  integrations      Integration[]
  aiSettings        ProductAISettings?
  launchChecklists  LaunchChecklist[]
  metrics           Metric[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  retentionCohorts  RetentionCohort[]
  tasks             Task[]
  timelineEvents    TimelineEvent[]
  metricSetup       MetricSetup?
  metricEntries     MetricEntry[]

  @@index([userId])
}

model AIConnection {
  id                    String             @id @default(cuid())
  userId                String
  provider              AIProvider
  authType              AIAuthType
  status                AIConnectionStatus @default(DISCONNECTED)
  label                 String?
  encryptedApiKey       String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  scopes                String?
  remoteAccountId       String?
  remoteAccountEmail    String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productSelections     ProductAISettings[]

  @@unique([userId, provider])
  @@index([userId])
}

model ProductAISettings {
  id                   String        @id @default(cuid())
  productId            String        @unique
  mode                 AIMode        @default(PLATFORM_DEFAULT)
  selectedConnectionId String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  product              Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  selectedConnection   AIConnection? @relation(fields: [selectedConnectionId], references: [id], onDelete: SetNull)

  @@index([selectedConnectionId])
}

model LaunchChecklist {
  id           String         @id @default(cuid())
  productId    String
  category     LaunchCategory
  title        String
  description  String?
  completed    Boolean        @default(false)
  completedAt  DateTime?
  order        Int            @default(0)
  priority     Priority       @default(MEDIUM)
  linkedTaskId String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  linkedTask   Task?          @relation("ChecklistTask", fields: [linkedTaskId], references: [id])
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model GrowthChecklist {
  id          String         @id @default(cuid())
  productId   String
  category    GrowthCategory
  title       String
  description String?
  completed   Boolean        @default(false)
  completedAt DateTime?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Task {
  id                  String           @id @default(cuid())
  productId           String
  title               String
  description         String?
  /// Why this matters for THIS specific product (one sentence). Sprint-3 schema completeness.
  whyItMatters        String?
  /// Concrete observable state when this task is finished.
  doneCriteria        String?
  /// First concrete action the founder should take.
  nextAction          String?
  /// Where this task came from. Used for instrumentation + dedupe heuristics.
  /// Values: AI_PLAN | AGENT_CHAT | MANUAL | COMPLETION_EFFECT | FOUNDER_COACH
  source              String?
  /// Category for navigation. Values: PRODUCT | MARKETING | LEGAL | TECH |
  /// ACQUISITION | ACTIVATION | RETENTION | REVENUE | MEASUREMENT
  /// (no OTHER bucket — tasks without a category are rejected at save time)
  category            String?
  status              TaskStatus       @default(TODO)
  priority            Priority         @default(MEDIUM)
  dueDate             DateTime?
  order               Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  launchChecklistItem LaunchChecklist? @relation("ChecklistTask")
  product             Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  events              TaskEvent[]

  @@index([productId])
  @@index([productId, status])
  @@index([productId, category])
}

/// Lifecycle instrumentation for tasks. Sprint-3 measurement layer:
/// answers "are users acting on fewer but better tasks?".
model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  productId String
  /// CREATED | DETAIL_OPENED | STARTED | COMPLETED | REOPENED | DISMISSED | DEDUPED
  eventType String
  /// Optional metadata as JSON string (e.g. dedupe target id, originating surface).
  metadata  String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([productId, eventType, createdAt])
  @@index([taskId, createdAt])
}

model Metric {
  id                  String       @id @default(cuid())
  productId           String
  date                DateTime
  dau                 Int?
  mau                 Int?
  mrr                 Float?
  activeSubscriptions Int?
  newSignups          Int?
  churnedUsers        Int?
  activationRate      Float?
  source              MetricSource @default(MANUAL)
  createdAt           DateTime     @default(now())
  product             Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([productId, date])
}

model RetentionCohort {
  id             String   @id @default(cuid())
  productId      String
  cohortDate     DateTime
  usersCount     Int
  retentionDay1  Float?
  retentionDay7  Float?
  retentionDay30 Float?
  retentionDay60 Float?
  retentionDay90 Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, cohortDate])
  @@index([productId])
}

model ActivationFunnel {
  id             String         @id @default(cuid())
  productId      String
  date           DateTime
  step           ActivationStep
  count          Int
  conversionRate Float?
  createdAt      DateTime       @default(now())
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date, step])
  @@index([productId, date])
}

model GrowthRoutine {
  id              String    @id @default(cuid())
  productId       String
  title           String
  description     String?
  frequency       Frequency
  lastCompletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Goal {
  id           String   @id @default(cuid())
  productId    String
  title        String
  targetValue  Float
  currentValue Float    @default(0)
  unit         String
  startDate    DateTime
  endDate      DateTime
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model TimelineEvent {
  id          String    @id @default(cuid())
  productId   String
  eventType   EventType
  title       String
  description String?
  date        DateTime
  createdAt   DateTime  @default(now())
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, date])
}

model Integration {
  id         String              @id @default(cuid())
  productId  String
  provider   IntegrationProvider
  status     IntegrationStatus   @default(DISCONNECTED)
  config     String?
  lastSyncAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  syncJobs   SyncJob[]

  @@unique([productId, provider])
  @@index([productId])
}

model SyncJob {
  id            String      @id @default(cuid())
  integrationId String
  status        SyncStatus
  startedAt     DateTime    @default(now())
  completedAt   DateTime?
  error         String?
  recordsSynced Int?
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
}

enum WaitlistStatus {
  PENDING
  APPROVED
  INVITED
  REJECTED
}

enum ProductStatus {
  PRE_LAUNCH
  LAUNCHED
  GROWING
}

enum LaunchCategory {
  PRODUCT
  MARKETING
  LEGAL
  TECH
}

enum GrowthCategory {
  ACQUISITION
  ACTIVATION
  RETENTION
  REVENUE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum MetricSource {
  MANUAL
  INTEGRATION
}

enum ActivationStep {
  SIGNUP
  ONBOARDING
  FIRST_ACTION
  ACTIVATED
}

enum Frequency {
  WEEKLY
  MONTHLY
}

enum EventType {
  LAUNCH
  MILESTONE
  GOAL_COMPLETED
  INTEGRATION_CONNECTED
  METRIC_THRESHOLD
  CUSTOM
}

enum IntegrationProvider {
  // P0 — Already built
  STRIPE
  GA4
  // P1 — Next sprint
  REVENUECAT
  APP_STORE_CONNECT
  GOOGLE_PLAY
  META_ADS
  // P2 — Scale-up
  GOOGLE_ADS
  TIKTOK_ADS
  APPSFLYER
}

enum AIProvider {
  GOOGLE_AI
  OPENAI
  ANTHROPIC
}

enum AIAuthType {
  OAUTH
  API_KEY
}

enum AIConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
}

enum AIMode {
  PLATFORM_DEFAULT
  CONNECTED_MODEL
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum PlanTier {
  FREE
  STARTER
  PRO
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum UsageResource {
  AI_MESSAGE
  AI_SUGGESTION
}

// --- MetricSetup / MetricEntry ---
// Replaces the Product.launchGoals JSON blob with proper DB entities.
// MetricSetup: one per product, stores AARRR metric selections + auxiliary config.
// MetricEntry: one row per product+date, stores user-entered AARRR funnel values.

model MetricSetup {
  id                  String        @id @default(cuid())
  productId           String        @unique
  selections          Json          // FunnelMetricSelection[] — AARRR stage → selected metric keys
  platforms           String[]      @default([])
  ignoredChecklistIds String[]      @default([])
  founderSummary      Json?         // { headline, summary, nextStep, strengths, focusAreas }
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  product             Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  entries             MetricEntry[]
}

model MetricEntry {
  id            String      @id @default(cuid())
  productId     String
  metricSetupId String
  date          DateTime    @db.Date
  values        Json        // Record<FunnelStageKey, number>
  createdAt     DateTime    @default(now())
  metricSetup   MetricSetup @relation(fields: [metricSetupId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([productId, date])
  @@index([metricSetupId])
}
